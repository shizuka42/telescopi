[Unit]
Description=TeleScoPi bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=${USER}
WorkingDirectory=/home/${USER}/telescopi
EnvironmentFile=/home/${USER}/telescopi/config/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/${USER}/telescopi/venv/bin/python3 /home/${USER}/telescopi/src/telescopi/telescopi.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
